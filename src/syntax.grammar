// Raku is not context-free, so this grammar does not try to parse
// statements and expressions. It tokenizes the input, nests brackets,
// and recognizes the heads of declarations. That keeps the tree
// usable on incomplete or unsupported code.

@context trackContext from "./tokens"

@top Program { element* }

// Pod is not here. A skipped node that is made of several tokens makes
// the parser record a lookahead when it is longer than 25 characters,
// and that keeps the tokens before it from being reused after an edit.
// It is an element, which can stand in all but a few of the places
// where whitespace can.
@skip { whitespace | LineComment | DocComment | BlockComment | rawHeredoc | interpolatingHeredoc }

element { nonBlock | Block | ";" }

// Everything that can appear between a declarator and its body.
nonBlock {
  Pod |
  radixNumber |
  Parens |
  Brackets |
  PackageDeclaration |
  RoutineDeclaration |
  RegexDeclaration |
  EnumDeclaration |
  SubsetDeclaration |
  ConstantDeclaration |
  MethodCall |
  VariableName |
  operatorVariable |
  AttributeName |
  SpecialVariable |
  Identifier |
  TypeName |
  Number |
  Version |
  quotedString |
  interpolatingWordList |
  regexLiteral |
  transliteration |
  PairKey |
  keyword |
  Operator |
  wordOperator |
  "," |
  ":" |
  "." |
  sigil
}

Block { "{" element* "}" }
Parens { "(" element* ")" }
Brackets { "[" element* "]" }

// A declaration runs up to its body block, or to the `;` of a
// `unit class Foo;` style declaration.
declarationTail { nonBlock* (Block | ";") }

PackageDeclaration {
  (kw<"class"> | kw<"role"> | kw<"grammar"> | kw<"module"> | kw<"package">)
  PackageName? declarationTail
}

RoutineDeclaration {
  (kw<"sub"> RoutineName? | (kw<"method"> | kw<"submethod">) methodRoutineName? |
   // `multi foo` without a declarator declares a sub. The `multi` is
   // outside of this node, as it is in `multi sub foo`.
   multiRoutineName)
  declarationTail
}

RegexDeclaration {
  (kw<"token"> | kw<"rule"> | kw<"regex">)
  RegexName? nonBlock* (RegexBlock | ";")
}

// The body of a regex declaration is in the regex language. Its pieces
// are read by regexToken.
RegexBlock[@name=Block] { "{" regexBody? "}" }

// A block of code in a regex.
RegexCode[@name=Block] { "{" element* "}" }

EnumDeclaration { kw<"enum"> EnumName? }
SubsetDeclaration { kw<"subset"> SubsetName? }
ConstantDeclaration { kw<"constant"> ConstantName? }

PackageName { declaredName }
RoutineName { declaredName }
// `method !private` and `method ^meta` keep their mark in the name.
methodRoutineName[@name=RoutineName] { declaredMethodName }
multiRoutineName[@name=RoutineName] { multiName }
RegexName { declaredName }
EnumName { declaredName }
SubsetName { declaredName }
// A constant can have a sigil: constant $LIMIT = 3
ConstantName { declaredName | declaredVariable }

MethodCall { methodDot MethodName }

// plainName is a word that would be a keyword elsewhere: `take => 1`, `take(1)`
Identifier { identifier | plainName }
// A capitalized name is taken to be a type, and may carry a type
// smiley: Int:D, Str:U, Any:_
TypeName { capIdentifier (smiley | noSmiley) }

@skip {} {
  // The body of a regex declaration. Its text is the part that no child
  // node covers.
  regexBody[@name=Regex] {
    regexStart regexPiece* regexBodyEnd
  }

  // The inside of a regex literal. The parser of Program reads a
  // literal as one token, regexLiteral, and this rule is parsed over
  // the text of that token (see index.ts). Its first token is the
  // opening delimiter, and its last the closing one with what follows.
  @top RegexLiteral[@name=Regex] {
    regexLitOpen regexPiece* regexLitClose
  }

  regexPiece {
    regexText | Escape | CharacterClass | Assertion | regexQuote | regexOperator | regexComment |
    regexBlockComment | regexCapture |
    VariableName | AttributeName | SpecialVariable | RegexCode
  }

  // A Pod block. Its text is the part that no child node covers.
  Pod {
    podStart
    (podText | PodDirective | PodHeading | PodStrong | PodEmphasis | PodCode | PodLink | PodFormat)*
    (podEnd | podEndDirective)
  }

  // The text of a heredoc that interpolates. The parser of Program
  // reads it as one token, interpolatingHeredoc, and this rule is
  // parsed over the text of that token.
  @top HeredocText[@name=Heredoc] { heredocStart quotePart* quoteEnd }

  quotedString[@name=StringLiteral] {
    // A quote that does not interpolate is one token.
    rawString |
    quoteStart quotePart* quoteEnd
  }

  // The inside of a <<...>> word list, which interpolates. The parser
  // of Program reads the list as one token, interpolatingWordList, and
  // this rule is parsed over the text of that token.
  @top WordList[@name=StringLiteral] { quoteStart quotePart* quoteEnd }

  quotePart {
    quoteContent | NestedDelimiters | Escape | Interpolation |
    // A `$` that does not start a variable is a lone sigil.
    (VariableName | AttributeName | SpecialVariable | sigil) quotePostfix*
  }

  // A pair of the quote's delimiters inside it: qq[a [b] c]. This is a
  // node, and not two kinds of part, so that a run of parts that is
  // reused after an edit closes every delimiter that it opens. Whether
  // a closing delimiter ends such a pair or the quote is then a matter
  // of where the parser is, which a reused node cannot get wrong.
  NestedDelimiters { quoteNestOpen quotePart* quoteNestClose }

  // After a variable: "@a[0]", "&f(1)", "%h<k>", "$o.m()". The
  // tokenizers tell this position from the text of the quote by whether
  // rawString can be shifted, which holds whatever was reused before it.
  quotePostfix { Brackets | Parens | rawString | MethodCall }
}

Interpolation { "{" element* "}" }

keyword {
  kw<"my"> | kw<"our"> | kw<"has"> | kw<"state"> | kw<"temp"> | kw<"let"> |
  kw<"anon"> | kw<"augment"> | kw<"supersede"> | kw<"unit"> |
  kw<"multi"> | kw<"proto"> | kw<"only"> |

  kw<"if"> | kw<"elsif"> | kw<"else"> | kw<"unless"> |
  kw<"with"> | kw<"orwith"> | kw<"without"> |
  kw<"for"> | kw<"while"> | kw<"until"> | kw<"loop"> | kw<"repeat"> |
  kw<"given"> | kw<"when"> | kw<"default"> |
  kw<"do"> | kw<"gather"> | kw<"take"> | kw<"try"> |
  kw<"return"> | kw<"next"> | kw<"last"> | kw<"redo"> |
  kw<"proceed"> | kw<"succeed"> |
  kw<"react"> | kw<"whenever"> | kw<"supply"> | kw<"emit"> | kw<"start"> |

  kw<"use"> | kw<"need"> | kw<"import"> | kw<"require"> | kw<"no"> |

  kw<"is"> | kw<"does"> | kw<"of"> | kw<"returns"> | kw<"handles"> |
  kw<"where"> | kw<"will"> | kw<"trusts"> | kw<"hides"> |

  kw<"and"> | kw<"or"> | kw<"not"> | kw<"xor"> | kw<"so"> |
  kw<"andthen"> | kw<"orelse"> | kw<"notandthen"> |
  // `x`, `xx`, `min` and `max` are not here: they are operators only
  // where an operator is expected, which termToken decides.
  kw<"div"> | kw<"mod"> | kw<"gcd"> | kw<"lcm"> |
  kw<"eq"> | kw<"ne"> | kw<"lt"> | kw<"gt"> | kw<"le"> | kw<"ge"> |
  kw<"cmp"> | kw<"leg"> | kw<"eqv"> | kw<"but"> |

  kw<"self"> |

  capKw<"True"> | capKw<"False"> | capKw<"Nil"> |

  capKw<"BEGIN"> | capKw<"CHECK"> | capKw<"INIT"> | capKw<"END"> |
  capKw<"ENTER"> | capKw<"LEAVE"> | capKw<"KEEP"> | capKw<"UNDO"> |
  capKw<"FIRST"> | capKw<"NEXT"> | capKw<"LAST"> | capKw<"PRE"> | capKw<"POST"> |
  capKw<"CATCH"> | capKw<"CONTROL"> | capKw<"QUIT"> | capKw<"CLOSE"> | capKw<"DOC">
}

kw<term> { @specialize[@name={term}]<identifier, term> }
capKw<term> { @specialize[@name={term}]<capIdentifier, term> }

// External tokenizers are tried in this order, before the tokens below.
// This one is first, so that a type name ends before the comment or the
// heredoc that follows it.
@external tokens smileyToken from "./tokens" { smiley, noSmiley }
@external tokens blockComment from "./tokens" { BlockComment }
@external tokens podToken from "./tokens" {
  podStart[@name=PodDirective], podEnd, podEndDirective[@name=PodDirective], podText,
  PodDirective, PodHeading, PodStrong, PodEmphasis, PodCode, PodLink, PodFormat
}
@external tokens heredocToken from "./tokens" {
  rawHeredoc[@name=Heredoc], interpolatingHeredoc[@name=Heredoc],
  // Empty, at the start of the text of a heredoc that is parsed again.
  heredocStart
}
@external tokens methodDotToken from "./tokens" { methodDot[@name="."] }
// Names in positions where a word is never a keyword: `method next`, `.default`.
@external tokens nameToken from "./tokens" { MethodName, declaredName, declaredMethodName, declaredVariable }
// This one needs to see that no identifier character follows.
@external tokens versionToken from "./tokens" { Version }
@external tokens regexToken from "./tokens" {
  // The first and the last of these are empty.
  regexStart, regexBodyEnd, regexLitOpen, regexLitClose, regexText, CharacterClass, Assertion,
  regexQuote[@name=StringLiteral], regexOperator[@name=Operator], regexComment[@name=LineComment],
  regexBlockComment[@name=BlockComment], regexCapture[@name=VariableName]
}
@external tokens quoteToken from "./tokens" { quoteContent, quoteNestOpen, quoteNestClose, quoteEnd }
// Tokens that depend on whether a term or an operator is expected.
@external tokens termToken from "./tokens" {
  rawString, quoteStart, interpolatingWordList[@name=StringLiteral], regexLiteral[@name=Regex], transliteration[@name=Regex], plainName, wordOperator[@name=Operator],
  // The name after `multi`, `proto` or `only`, when no declarator follows.
  multiName,
  // &infix:<+>
  operatorVariable[@name=VariableName]
}

@tokens {
  whitespace { @whitespace+ }

  LineComment { "#" ![\n]* }
  DocComment { "#" $[|=] ![\n]* }
  @precedence { DocComment, LineComment }

  // Keep these ranges in sync with isIdentifierStart in tokens.ts. They
  // leave out the punctuation and symbol blocks, where Raku's Unicode
  // operators and brackets live. Combining marks are included, so that
  // decomposed accented letters do not split a name.
  capStart { $[A-Z] }
  lowerStart { $[a-z_\u{aa}\u{b5}\u{ba}\u{c0}-\u{d6}\u{d8}-\u{f6}\u{f8}-\u{167f}\u{1681}-\u{1fff}\u{2c00}-\u{2fef}\u{3040}-\u{d7ff}\u{f900}-\u{fdff}\u{ff21}-\u{ff3a}\u{ff41}-\u{ff5a}\u{ff66}-\u{ffdc}\u{10000}-\u{10ffff}] }
  identifierStart { capStart | lowerStart }
  // A hyphen or apostrophe belongs to an identifier only when a letter
  // follows, so `$a-1` stays a subtraction.
  wordRest { (identifierStart | @digit | $[\-'] identifierStart)* }
  word { identifierStart wordRest }
  qualifiedRest { ("::" word)* }
  qualifiedWord { word qualifiedRest }

  identifier { lowerStart wordRest qualifiedRest }
  capIdentifier { capStart wordRest qualifiedRest }

  PairKey { ":" "!"? qualifiedWord }

  // Where one token is a prefix of another, the longer one is listed
  // first, so that it wins whenever it matches.
  @precedence {
    AttributeName, SpecialVariable, VariableName,
    radixNumber, PairKey, Operator, sigil, ":", "."
  }

  sigilChar { $[$@%&] }
  VariableName { sigilChar $[\^:]? qualifiedWord | "$" @digit+ | "$" $[/!\u{a2}] }
  AttributeName { sigilChar $[!.] qualifiedWord }
  SpecialVariable { sigilChar $[*?=~] qualifiedWord }
  sigil { $[$@] }

  digits { @digit+ ("_" @digit+)* }
  Number {
    digits ("." digits)? ($[eE] $[+\-]? @digit+)? "i"? |
    "0" $[xX] $[0-9a-fA-F_]+ |
    "0" $[oO] $[0-7_]+ |
    "0" $[bB] $[01_]+ |
    "0" $[dD] $[0-9_]+ |
    // A fraction that is one character: ½, ⅔
    $[\u{bc}-\u{be}\u{2150}-\u{215f}\u{2189}]
  }

  // :16<FF>
  radixNumber[@name=Number] { ":" @digit+ "<" $[0-9a-zA-Z_.]+ ">" }

  Escape { "\\" _ }

  // ASCII operator characters, and the symbols outside of ASCII: « » ×
  // ÷ … ∘ ⚛ and the like. An operator of one's own is usually made of
  // such symbols (infix:<⚡>), and is not known where it is used. The
  // ranges leave out the quotes (‘ ’ “ ” ‚ „), the spaces, the
  // superscripts and the fractions.
  operatorChar {
    $[+\-*/~^|<>=!?\\\u{a1}-\u{a9}\u{ab}\u{ac}\u{ae}-\u{b1}\u{b4}\u{b6}-\u{b8}\u{bb}\u{bf}\u{d7}\u{f7}]
    | $[\u{2010}-\u{2017}\u{2020}-\u{2027}\u{2030}-\u{205e}\u{2190}-\u{2bff}]
  }
  Operator {
    operatorChar+ |
    // A power written in superscript: $x², 2⁻¹
    $[\u{b2}\u{b3}\u{b9}\u{2070}\u{2074}-\u{207b}]+ |
    // `%` and `&` are also sigils. Keeping them out of operator runs lets
    // `*%opts` and `|&code` end in a variable.
    "%" "%"? "="? | "&" "&"? "="? |
    ".." "."? "^"? | ".=" | "::"? ":="
  }

  "{" "}" "(" ")" "[" "]"
  "," ";" ":" "."
}

@detectDelim
