{
  "name": "codemirror-lang-raku",
  "version": "0.1.0",
  "description": "Raku (formerly Perl 6) language support for CodeMirror",
  "keywords": [
    "codemirror",
    "codemirror6",
    "lezer",
    "raku",
    "perl6",
    "syntax-highlighting"
  ],
  "author": "Kan Fushihara",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kan/codemirror-lang-raku.git"
  },
  "scripts": {
    "build": "rollup -c",
    "pretest": "npm run build",
    "test": "mocha test/test.js",
    "prepare": "npm run build"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.js",
    "require": "./dist/index.cjs"
  },
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "dependencies": {
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/lr": "^1.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@lezer/generator": "^1.8.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.6.4",
    "mocha": "^12.0.3",
    "rollup": "^4.64.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
